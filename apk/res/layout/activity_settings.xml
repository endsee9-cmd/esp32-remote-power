<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页:目标名称 + MQTT 参数回显,保存走 PowerManager.saveConfig -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- 目标电脑名称 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_target_name"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/edit_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hint_target_name"
            android:inputType="text"
            android:singleLine="true"
            android:maxLines="1" />

        <!-- MQTT 地址 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_broker"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/edit_broker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hint_broker"
            android:inputType="textUri"
            android:singleLine="true"
            android:maxLines="1" />

        <!-- 端口 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_port"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/edit_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hint_port"
            android:inputType="number"
            android:singleLine="true"
            android:maxLines="1" />

        <!-- TLS 开关 -->
        <Switch
            android:id="@+id/switch_tls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/label_tls"
            android:textSize="15sp"
            android:textColor="@color/text_primary" />

        <!-- 用户名 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_user"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/edit_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hint_user"
            android:inputType="text"
            android:singleLine="true"
            android:maxLines="1" />

        <!-- 密码 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_pass"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/edit_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hint_pass"
            android:inputType="textPassword"
            android:singleLine="true"
            android:maxLines="1" />

        <!-- 主题前缀 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_prefix"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
        <EditText
            android:id="@+id/edit_prefix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hint_prefix"
            android:inputType="text"
            android:singleLine="true"
            android:maxLines="1" />

        <!-- 连接检查结果 -->
        <TextView
            android:id="@+id/text_conn_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="14sp" />

        <!-- 操作按钮:保存是主操作(亮蓝),其余次级(暗色) -->
        <Button
            android:id="@+id/btn_save"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/btn_save" />

        <Button
            android:id="@+id/btn_check"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_check_conn" />

        <Button
            android:id="@+id/btn_add_tile"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/btn_add_tile" />

        <Button
            android:id="@+id/btn_diagnostics"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_open_diagnostics" />
    </LinearLayout>
</ScrollView>
