# 构建产物
build/
*.apk
*.apk.idsig
*.dex
*.class
*.o
*.obj

# ---------- 本机配置与凭据:绝对不要提交 ----------
# ESP-IDF 的真配置(含 Wi-Fi 密码、Broker 账号),只留 sdkconfig.defaults 里的占位值
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
# 学校 / 单位的 RADIUS CA 证书,按需自行放置
*.pem

# 密钥库:自己生成或自己保管,不进仓库
*.keystore
*.jks
*.p12
apk/debug.keystore

# 固件镜像:编译时会内嵌本机 Wi-Fi 与 Broker 凭据,反编译即可读出
*.bin
*.elf

# ---------- 依赖与工具链 ----------
node_modules/
tools/
jdk*/
android-sdk/
# 工具链安装包
*.zip

# ---------- 日志 ----------
*.log
logs/

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini
